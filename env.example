# Copy to .env and set only the values needed for your deployment.

# Runtime
LOG_LEVEL=INFO
LOG_FILE=unified_mcp.log
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8001
COMMAND_TIMEOUT=300
OPERATION_TIMEOUT=300
MAX_CONCURRENT_COMMANDS=5
MAX_CONCURRENT_OPERATIONS=5

# HTTP security (streamable-http, sse, and openapi)
# Generate a long random value and send it as: Authorization: Bearer <value>
MCP_API_KEY=
# Comma-separated browser origins. This is not a replacement for MCP_API_KEY.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8001,http://localhost:8001

# Optional safety control for Docker Compose or a manually started server.
# IDE-managed Docker users pass this with: -e EXECUTION_POLICY=read-only
# unrestricted: permits supported reads and changes (default)
# read-only: intended for investigation and reporting
# allowlist: permits only the prefixes listed below
EXECUTION_POLICY=unrestricted
# Comma-separated parsed Azure CLI prefixes, used only in allowlist mode.
AZURE_COMMAND_ALLOWLIST=
# Comma-separated "METHOD /path" prefixes, used only in allowlist mode.
GRAPH_REQUEST_ALLOWLIST=

# Managed identity: preferred for workloads hosted in Azure.
# Leave MANAGED_IDENTITY_CLIENT_ID empty for a system-assigned identity.
USE_MANAGED_IDENTITY=false
MANAGED_IDENTITY_CLIENT_ID=

# Azure CLI service-principal authentication.
# Leave empty for interactive `az login` when using the local stdio transport.
AZURE_APP_TENANT_ID=
AZURE_APP_CLIENT_ID=
AZURE_APP_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=

# Reuse the Azure service principal for Microsoft Graph.
SHARE_APP_REGISTRATION=false

# Interactive sign-in flow for Microsoft Graph, Azure REST, and az login: "browser"
# (default) opens a browser window like az login / Connect-AzAccount; "device_code" shows
# a code for hosts without a browser. The Docker image sets device_code.
# SIGN_IN_FLOW=browser

# Sign-in cache. When enabled (default), a completed sign-in is
# persisted so later runs refresh silently instead of prompting again. To keep the
# sign-in across container restarts, mount a volume at /home/app/.IdentityService.
GRAPH_TOKEN_CACHE=true
# Optional: directory for the persisted sign-in record. Defaults to ~/.IdentityService.
TOKEN_CACHE_DIR=

# Opt-in Resource inventory for azure_find_resource: a local file (beside the token
# cache, mode 0600) listing every Azure resource you can see. It maps your whole Azure
# estate, so it is off by default. Consent is this setting or the consent file written
# by `unified-microsoft-mcp resource-inventory on`; `off` deletes the file.
RESOURCE_INVENTORY=false

# Encrypt the cached sign-in at rest. The Docker image runs a keyring (Secret
# Service) so azure-identity stores tokens encrypted rather than in plaintext. Set
# ENABLE_KEYRING=false to disable it (tokens then fall back to a plaintext file).
# KEYRING_PASSWORD unlocks the keyring; leave empty for an auto-unlocked keyring, or
# set a value (ideally from a secret store) for password-protected encryption.
ENABLE_KEYRING=true
KEYRING_PASSWORD=

# Azure Resource Manager REST fallback for azure_read / azure_write, used automatically
# when the Azure CLI is unavailable or its app id is blocked by Conditional Access. Interactive sign-in
# uses AZURE_ARM_CLIENT_ID (Azure PowerShell public client by default), which a
# locked-down tenant may permit even when the Azure CLI is blocked.
ENABLE_AZURE_REST=true
AZURE_ARM_CLIENT_ID=1950a258-227b-4e31-a9cf-717495945fc2
AZURE_ARM_SCOPE=https://management.azure.com/.default

# Kubernetes (AKS) tools: kubernetes_connect, kubernetes_read, kubernetes_write. They run
# your own az, kubelogin, and kubectl with your kubeconfig (KUBECONFIG is respected), so
# they are for desktop use; the Docker image does not include kubectl or kubelogin. In
# allowlist mode, list kubectl prefixes (for example "kubectl get") in
# AZURE_COMMAND_ALLOWLIST; read-only mode allows kubernetes_read only.
ENABLE_KUBERNETES=true

# Microsoft Graph custom application authentication.
# Leave empty to sign in as the user with the permissions the Tenant has already granted.
GRAPH_APP_CLIENT_ID=
GRAPH_APP_TENANT_ID=
GRAPH_APP_CLIENT_SECRET=

# Optional delegated-mode overrides.
GRAPH_TENANT_ID=common
GRAPH_CLIENT_ID=14d82eec-204b-4c2f-b7e8-296a70dab67e
# Comma-separated delegated permissions. By default the server asks only for what the
# Tenant has already granted (https://graph.microsoft.com/.default), so no consent
# prompt appears. List scopes here to sign in with more permissions; any not yet
# granted show a consent prompt that Tenant policy may block.
# GRAPH_SCOPES=https://graph.microsoft.com/User.Read,https://graph.microsoft.com/Mail.Read

# Test-only switch. Never enable in a real deployment.
MOCK_MODE=false

# Backward-compatible aliases are still accepted:
# USE_APP_REG_CLIENTID, TENANTID, CLIENT_SECRET, GRAPH_CLIENT_SECRET
